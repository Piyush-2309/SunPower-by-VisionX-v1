# ============================================
# SunFlow 360 - Environment Variables
# ============================================
# Copy this file to .env and fill in actual values.
# NEVER commit the .env file to version control.

# --- Database (Stage 2) ---
SUNFLOW_DB_HOST=localhost
SUNFLOW_DB_PORT=5432
SUNFLOW_DB_NAME=sunflow_dev
SUNFLOW_DB_USERNAME=sunflow_user
SUNFLOW_DB_PASSWORD=your_password_here

# --- LLM API (Stage 6) ---
LLM_API_KEY=your_api_key_here
LLM_API_PROVIDER=openai

# --- WhatsApp Business API (Stage 8) ---
WHATSAPP_API_TOKEN=your_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_id_here
WHATSAPP_VERIFY_TOKEN=your_verify_token_here

# --- Application ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
